{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LittleSU TV",
  "version": "1.7.0",
  "identifier": "com.xiaowulai.littlesu",
  "build": {
    "frontendDist": "../ui-next/dist",
    "devUrl": "http://localhost:5174",
    "beforeDevCommand": "npm run dev:ui-next",
    "beforeBuildCommand": "npm run build:ui-next"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "LittleSU TV",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "maximized": true,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        "default"
      ]
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/xiaowulai-s/LittleSU/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE3RUE4OURCQjYwODlGMDgKUldRSW53aTIyNG5xcC9JMzhnK0JLWTNLUXdscVNmMUhxblluOENvaDc4U090YktoMGtsWDJnaGgK"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "minSdkVersion": 24
    }
  }
}
